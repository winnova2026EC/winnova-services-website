---
import Icon from "./Icon.astro";
---

<div class="connection-art">
  <div class="art-topline">
    <span>El ecosistema Winnova Solutions</span><span class="art-plus" aria-hidden="true"
      >+</span>
  </div>
  <svg class="orbit-art animate-fade" viewBox="0 0 580 540" fill="none" aria-hidden="true">
    <defs>
      <linearGradient
        id="orbit-front"
        x1="110"
        y1="360"
        x2="470"
        y2="160"
        gradientUnits="userSpaceOnUse"
        ><stop stop-color="#2454C6"></stop><stop
          offset=".36"
          stop-color="#19C5E8"></stop><stop offset=".68" stop-color="#884CDC"
        ></stop><stop offset="1" stop-color="#ED489C"></stop></linearGradient
      >
      <linearGradient
        id="orbit-back"
        x1="135"
        y1="145"
        x2="430"
        y2="365"
        gradientUnits="userSpaceOnUse"
        ><stop stop-color="#FFDA73"></stop><stop
          offset=".35"
          stop-color="#FFAA66"></stop><stop offset=".68" stop-color="#ED489C"
        ></stop><stop offset="1" stop-color="#482DAD"></stop></linearGradient
      >
      <linearGradient
        id="orbit-lines"
        x1="50"
        y1="0"
        x2="560"
        y2="540"
        gradientUnits="userSpaceOnUse"
        ><stop stop-color="#ED489C"></stop><stop
          offset=".35"
          stop-color="#FFBF43"></stop><stop offset=".65" stop-color="#19C5E8"
        ></stop><stop offset="1" stop-color="#884CDC"></stop></linearGradient
      >
    </defs>
    <ellipse
      cx="290"
      cy="273"
      rx="224"
      ry="181"
      stroke="#E4DFF3"
      stroke-dasharray="3 7"
      transform="rotate(-23 290 273)"></ellipse>
    <path
      d="M131 276C111 209 148 139 222 122C305 102 405 149 443 229C481 309 438 390 365 414"
      stroke="url(#orbit-back)"
      stroke-width="62"></path>
    <path
      d="M131 276C111 209 148 139 222 122C305 102 405 149 443 229"
      stroke="white"
      stroke-opacity=".2"
      stroke-width="2"
      transform="translate(-10 -10)"></path>
    <path
      d="M365 414C302 440 208 402 159 347C110 292 115 222 171 184C238 139 364 164 419 235C470 301 435 372 365 414Z"
      stroke="url(#orbit-front)"
      stroke-width="51"></path>
    <path
      d="M365 414C302 440 208 402 159 347C110 292 115 222 171 184"
      stroke="white"
      stroke-opacity=".3"
      stroke-width="2"
      transform="translate(0 -15)"></path>
    {
      [0, 1, 2, 3, 4, 5, 6, 7].map((n) => (
        <path
          d={`M-40 ${435 + n * 5} C110 ${329 + n * 7} 204 ${507 - n * 7} 322 ${454 - n * 3} S486 ${319 + n * 7} 620 ${402 + n * 6}`}
          stroke="url(#orbit-lines)"
          stroke-width="1"
          opacity={0.19 + n * 0.025}
        />
      ))
    }
    <circle cx="471" cy="159" r="5" fill="#ED489C"></circle><rect
      x="95"
      y="371"
      width="10"
      height="10"
      rx="2"
      fill="#19C5E8"
      transform="rotate(20 95 371)"></rect><rect
      x="443"
      y="420"
      width="8"
      height="8"
      rx="1"
      fill="#FFBF43"
      transform="rotate(-15 443 420)"></rect>
  </svg>
  <div class="company-core">
    <span>Todo gira alrededor de</span><strong>tu empresa.</strong><span
      class="core-rule"
      aria-hidden="true"></span>
  </div>
  <a
    class="orbit-node node-contable animate-fade"
    href="#contable"
    data-hero-product="contable"
    ><span class="node-icon blue"><Icon name="cube" /></span><span
      ><strong>Cubo Contable</strong><small>Todo bajo control</small></span
    ><Icon name="diagonal" /></a
  >
  <a class="orbit-node node-edocs animate-fade" href="#edocs" data-hero-product="edocs"
    ><span class="node-icon pink"><Icon name="document" /></span><span
      ><strong>Cubo e-Docs</strong><small>Facturación que fluye</small></span
    ><Icon name="diagonal" /></a
  >
  <a
    class="orbit-node node-download animate-fade"
    href="#descargas"
    data-hero-product="descargas"
    ><span class="node-icon amber"><Icon name="download" /></span><span
      ><strong>Descarga SRI</strong><small>Comprobantes en orden</small></span
    ><Icon name="diagonal" /></a
  >
  <a
    class="orbit-node node-guides animate-fade"
    href="#guias-camaroneras"
    data-hero-product="guias-camaroneras"
    ><span class="node-icon cyan"><Icon name="truck" /></span><span
      ><strong>Guías electrónicas</strong><small>Sector camaronero</small></span
    ><Icon name="diagonal" /></a
  >
</div>
