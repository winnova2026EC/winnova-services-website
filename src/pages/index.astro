---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Connection from "../components/Connection.astro";
import { Image } from "astro:assets";
import logo from "../assets/imagenes/logo.jpeg";

const whatsapp = "https://wa.me/593984206215?text=";
const contact =
  whatsapp +
  encodeURIComponent(
    "Hola, me gustaría conocer las soluciones de Winnova Solutions para mi negocio.",
  );
const edocsAccess = "https://facturacionlinkservices.com/acceso_seguro.php";
const guidesAccess = "https://guias.facturacionlinkservices.com/login";
const supremoDownload = "/downloads/Supremo_Winnova.exe";

const container = "mx-auto w-[min(1240px,calc(100%_-_112px))] max-[1100px]:w-[calc(100%_-_72px)] max-[850px]:w-[calc(100%_-_48px)] max-sm:w-[calc(100%_-_40px)]";
const heading2 = "font-heading text-[clamp(30px,3.2vw,44px)] font-semibold leading-[1.2] tracking-[-0.055em] text-balance max-sm:text-[32px]";
const sectionLabel = "mb-[15px] text-[16px] font-semibold text-brand-blue max-sm:mb-3 max-sm:text-[14px]";
const button = "inline-flex min-h-[54px] items-center justify-center gap-4 rounded-lg border border-transparent px-[23px] py-4 text-[17px] font-semibold leading-[1.25] [&_svg]:size-5";
const textLink = "inline-flex min-h-11 items-center gap-2.5 text-[17px] font-semibold hover:text-brand-blue [&_svg]:size-[19px]";
const sectionSpace = "py-[108px] max-[850px]:py-[76px] max-sm:py-[58px]";

const products = [
  {
    id: "contable",
    name: "Cubo Contable",
    category: "Tu empresa, en un solo lugar",
    icon: "cube",
    color: "blue",
    title: "Menos tareas sueltas. Más control de tu negocio.",
    description:
      "Conecta tu contabilidad, facturación e inventarios en una plataforma web. Trabaja con tu equipo y tu contador, desde cualquier lugar y dispositivo.",
    features: [
      "Contabilidad y balances",
      "Inventarios y compras",
      "Facturación electrónica y ATS",
      "Cuentas por cobrar y pagar",
    ],
    cta: "Conocer Cubo Contable",
    message:
      "Hola, quiero conocer Cubo Contable y cómo se adapta a mi empresa.",
  },
  {
    id: "edocs",
    name: "Cubo e-Docs",
    category: "De la emisión a la entrega",
    icon: "document",
    color: "pink",
    title: "Tus documentos electrónicos, con el camino resuelto.",
    description:
      "Automatiza la firma, el envío al SRI y la entrega de comprobantes a tus clientes y proveedores. Consulta su autorización desde un portal en la nube.",
    features: [
      "Firma automática de XML",
      "Envío y consulta al SRI",
      "Correos automáticos",
      "Portal de comprobantes",
    ],
    cta: "Conocer Cubo e-Docs",
    message:
      "Hola, me gustaría conocer Cubo e-Docs para mis documentos electrónicos.",
  },
  {
    id: "descargas",
    name: "Descarga SRI",
    category: "Del comprobante a la información",
    icon: "download",
    color: "amber",
    title: "Más información a mano. Menos trabajo manual.",
    description:
      "Descarga de forma masiva tus comprobantes emitidos y recibidos del SRI. Obtén los XML, genera RIDE en PDF y organiza la información de varios contribuyentes.",
    features: [
      "Descarga masiva de XML",
      "Generación de RIDE en PDF",
      "Registros para ATS",
      "Reportes y exportación a Excel",
    ],
    cta: "Conocer Descarga SRI",
    message:
      "Hola, quiero información sobre la descarga masiva de comprobantes del SRI.",
  },
  {
    id: "guias-camaroneras",
    name: "Guías electrónicas",
    category: "Para el sector camaronero",
    icon: "truck",
    color: "cyan",
    title: "De la piscina al destino. Tus guías, en menos tiempo.",
    description:
      "Solución 100 % web para generar y gestionar Guías de Remisión Electrónicas del sector camaronero. Agiliza el registro de tu operación y accede desde cualquier navegador y diferentes ubicaciones.",
    features: [
      "Camaroneras y piscinas de origen",
      "Artículos y productos",
      "Transportistas y choferes",
      "Gestión de destinos",
      "Cantidades expresadas en libras",
      "Usuarios y contraseñas",
      "Roles y permisos por función",
      "Generación ágil de guías electrónicas",
    ],
    visualFeatures: [
      "Camaroneras y piscinas",
      "Transportistas y choferes",
      "Destinos y libras",
      "Guías electrónicas",
    ],
    cta: "Conocer Guías electrónicas",
    message:
      "Hola, quiero conocer la solución de Guías de Remisión Electrónicas para el sector camaronero.",
  },
];

const productDetails: Record<
  string,
  {
    subtitle: string;
    kicker: string;
    hub: string;
    hubDescription: string;
    note: string;
  }
> = {
  contable: {
    subtitle: "Contabilidad en la nube",
    kicker: "Todo empieza con una visión completa",
    hub: "Tu empresa",
    hubDescription: "Una sola plataforma",
    note: "Mac, Windows o Linux. Tú eliges.",
  },
  edocs: {
    subtitle: "Facturación electrónica",
    kicker: "Un proceso conectado de principio a fin",
    hub: "Tu comprobante",
    hubDescription: "Firma, envío y consulta",
    note: "Consulta tus documentos desde el portal web.",
  },
  descargas: {
    subtitle: "Comprobantes en orden",
    kicker: "Tu información, lista para trabajar",
    hub: "Tus documentos",
    hubDescription: "Emitidos y recibidos",
    note: "Varios contribuyentes. Un mismo sistema.",
  },
  "guias-camaroneras": {
    subtitle: "Sector camaronero",
    kicker: "Guías de Remisión Electrónicas para tu operación",
    hub: "Tu movilización",
    hubDescription: "Del origen al destino",
    note: "Acceso web con usuarios, roles y permisos.",
  },
};
const modules = [
  {
    icon: "document",
    title: "Ventas y facturación",
    text: "Facturación electrónica, generación de ATS y gestión de clientes. Conecta tu operación comercial con tu contabilidad.",
  },
  {
    icon: "box",
    title: "Inventarios y compras",
    text: "Administra inventarios o servicios, proveedores, importaciones y el ingreso de compras y retenciones mediante archivos TXT.",
  },
  {
    icon: "wallet",
    title: "Finanzas y tesorería",
    text: "Organiza cuentas por cobrar y pagar, bancos, cajas, cheques y tarjetas, junto con el control de activos fijos.",
  },
  {
    icon: "chart",
    title: "Contabilidad y reportes",
    text: "Consulta balances, mayores y libros diarios. Trabaja con información centralizada para entender el estado de tu empresa.",
  },
  {
    icon: "users",
    title: "Equipo y permisos",
    text: "Colabora con varios usuarios. Define roles y permisos para que cada persona acceda a la información que necesita.",
  },
  {
    icon: "connect",
    title: "Integraciones y flexibilidad",
    text: "Conecta aplicaciones externas mediante APIs y adapta las funcionalidades a las necesidades específicas de tu empresa.",
  },
];
---

<Layout>
  <a class="fixed left-3 top-3 z-[100] -translate-y-[150%] bg-ink px-5 py-3 text-white focus:translate-y-0" href="#contenido">Ir al contenido</a>
  <header class="sticky top-0 z-30 border-b border-line bg-white">
    <div class:list={[container, "flex min-h-[94px] items-center justify-between gap-[30px] max-[850px]:min-h-20 max-[850px]:gap-5 max-sm:min-h-[76px] max-sm:gap-3"]}>
      <a class="inline-block shrink-0 [&_img]:mix-blend-multiply [&_img]:brightness-[1.035] max-[850px]:[&_img]:w-[175px] max-sm:[&_img]:w-40" href="/" aria-label="Winnova Solutions, inicio"
        ><Image
          src={logo}
          alt="Winnova Solutions"
          width={200}
          height={69}
          loading="eager"
        /></a
      >
      <nav class="ml-auto mr-[34px] flex gap-[38px] text-[17px] font-medium max-[850px]:mr-0 max-[850px]:gap-[22px] max-[850px]:text-[15px] max-sm:hidden [&_a]:py-3 [&_a:hover]:text-brand-blue" aria-label="Navegación principal">
        <a href="#soluciones">Soluciones</a><a href="#nosotros">Nosotros</a><a
          href="#soporte">Soporte</a>
      </nav>
      <a
        class:list={[button, "min-h-[46px] bg-ink px-5 py-3 text-white hover:bg-[#453176] max-[850px]:px-3.5 max-[850px]:text-[15px] max-sm:hidden"]}
        href={contact}
        target="_blank"
        rel="noopener noreferrer">Hablemos <Icon name="chat" /></a
      >
      <button
        class="menu-toggle hidden size-[46px] items-center justify-center rounded-md border border-line bg-white text-ink max-sm:flex"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"><Icon name="menu" /></button
      >
    </div><nav
      id="mobile-nav"
      class="mobile-nav absolute inset-x-0 top-full border-t border-line bg-white px-6 pb-5 pt-2 shadow-[0_16px_24px_#21174712] [&_a]:block [&_a]:px-2 [&_a]:py-3"
      aria-label="Navegación móvil"
      hidden
    >
      <a href="#soluciones">Soluciones</a><a href="#nosotros">Nosotros</a><a
        href="#soporte">Soporte</a
      ><a href={contact} target="_blank" rel="noopener noreferrer"
        >Hablemos por WhatsApp</a>
    </nav>
    <div class="bg-ink text-white">
      <div class:list={[container, "flex min-h-[42px] items-center justify-end gap-[22px] text-[14px] max-sm:min-h-14 max-sm:justify-center max-sm:text-center max-sm:text-[12px] max-sm:leading-tight"]}>
        <span class="text-[#cfc8e2] max-sm:hidden">Accesos para clientes</span>
        <nav class="flex items-center max-sm:grid max-sm:w-full max-sm:grid-cols-[1.35fr_.85fr] [&_a]:inline-flex [&_a]:min-h-[42px] [&_a]:items-center [&_a]:gap-2 [&_a]:font-semibold [&_a:hover]:text-brand-cyan [&_a_svg]:size-[17px] max-sm:[&_a]:min-h-14 max-sm:[&_a]:justify-center max-sm:[&_a]:gap-[5px] max-sm:[&_a]:px-2 max-sm:[&_a_svg]:size-[15px] [&_a+a]:ml-[22px] [&_a+a]:border-l [&_a+a]:border-white/20 [&_a+a]:pl-[22px] max-sm:[&_a+a]:ml-0 max-sm:[&_a+a]:pl-2" aria-label="Accesos a plataformas">
          <a href={edocsAccess} target="_blank" rel="noopener noreferrer">
            Consultar comprobantes electrónicos <Icon name="diagonal" />
          </a>
          <a href={guidesAccess} target="_blank" rel="noopener noreferrer">
            Generación de guías <Icon name="diagonal" />
          </a>
        </nav>
      </div>
    </div>
  </header>
  <main id="contenido">
    <section class:list={[container, "grid grid-cols-[1.05fr_1fr] items-center gap-[52px] pb-16 pt-[68px] min-[1500px]:gap-20 min-[1500px]:py-20 max-[1100px]:gap-7 max-[850px]:grid-cols-2 max-[850px]:gap-5 max-[850px]:py-[52px] max-sm:grid-cols-1 max-sm:gap-9 max-sm:pb-9 max-sm:pt-[38px]"]} id="inicio" aria-labelledby="hero-title">
      <div class="py-2.5 max-sm:p-0">
        <p class="animate-fade-up mb-[26px] flex items-center gap-2.5 text-[15px] font-semibold max-[850px]:text-[13px] max-sm:mb-[23px]">
          <span class="size-3.5 rounded-full bg-[conic-gradient(#ffbf43_0_33%,#2454c6_33%_66%,#ed489c_66%)]" aria-hidden="true"></span> Tecnología hecha
          para Ecuador
        </p>
        <h1 class="animate-fade-up font-heading text-[clamp(56px,5.5vw,78px)] font-semibold leading-[1.055] tracking-[-0.065em] max-[1100px]:text-[62px] max-[850px]:text-[51px] max-sm:text-[clamp(47px,12.5vw,65px)] max-sm:leading-[1.06]" id="hero-title">Tu negocio,<br />en buena<br />conexión.</h1>
        <p class="animate-fade-up mt-[26px] max-w-[455px] text-[19px] leading-[1.55] text-muted max-[850px]:text-[17px] max-sm:mt-[22px] max-sm:max-w-[450px] max-sm:text-[18px]">
          Contabilidad, facturación electrónica, comprobantes y guías de
          remisión. Soluciones para organizar tu empresa y seguir creciendo.
        </p>
        <div class="animate-fade-up mt-[30px] flex flex-wrap items-center gap-[21px] max-[1100px]:gap-3 max-[850px]:flex-col max-[850px]:items-start max-[850px]:gap-2.5 max-sm:mt-[25px] max-sm:flex-row max-sm:gap-x-[19px] max-sm:gap-y-3.5">
          <a
            class:list={[button, "bg-brand-blue text-white hover:bg-[#193c99] max-[1100px]:px-4 max-[1100px]:text-[15px] max-sm:px-[19px] max-sm:text-[16px]"]}
            href={contact}
            target="_blank"
            rel="noopener noreferrer"
            >Hablemos de tu negocio <Icon name="chat" /></a
          ><a class:list={[textLink, "text-[16px] max-[1100px]:text-[15px]"]} href="#soluciones"
            >Explorar soluciones <Icon name="down" /></a>
        </div>
        <div class="animate-fade-up mt-6 flex items-center gap-[9px] text-[14px] text-muted max-[850px]:text-[12px] max-sm:mt-[19px] max-sm:text-[13px] [&_svg]:size-[17px] [&_svg]:text-brand-blue">
          <Icon name="check-circle" /><span
            >Software en la nube. Personas a tu lado.</span>
        </div>
      </div>
      <div class="min-w-0 max-sm:mx-auto max-sm:w-full max-sm:max-w-[470px]">
        <Connection /><div class="flex items-center justify-center gap-[9px] pt-[21px] text-[13px] text-muted max-sm:pt-4 max-sm:text-[12px]">
          <span class="size-1.5 rounded-full bg-brand-blue" aria-hidden="true"></span> Cada parte de tu negocio,
          conectada.
        </div>
      </div>
    </section>
    <div class="border-y border-line bg-[#faf9fc]">
      <div class:list={[container, "grid grid-cols-[1.03fr_.94fr_1.05fr_1.15fr] py-[29px] max-[850px]:grid-cols-2 max-[850px]:gap-y-[26px] max-[850px]:py-[26px] max-sm:[&_svg]:size-[23px] [&>div]:flex [&>div]:items-center [&>div]:gap-[18px] [&>div]:border-l [&>div]:border-[#ded9e9] [&>div]:pl-[34px] [&>div]:text-[15px] [&>div]:leading-[1.4] [&>div]:text-muted max-[1100px]:[&>div]:gap-3 max-[1100px]:[&>div]:pl-[22px] max-[1100px]:[&>div]:text-[14px] max-[850px]:[&>div:nth-child(3)]:border-0 max-[850px]:[&>div:nth-child(3)]:pl-0 max-sm:[&>div]:gap-2.5 max-sm:[&>div]:pl-[18px] max-sm:[&>div]:text-[12px] [&>div:first-child]:flex-col [&>div:first-child]:items-start [&>div:first-child]:gap-0.5 [&>div:first-child]:border-0 [&>div:first-child]:pl-0 [&_svg]:size-[27px] [&_svg]:text-[#776899] [&_strong]:font-semibold [&_strong]:text-ink"]}>
        <div>
          <span class="font-heading text-[23px] font-semibold tracking-[-0.045em] text-ink max-[1100px]:text-[21px] max-sm:text-[20px]">Desde 2014</span><span
            >implementando software</span>
        </div>
        <div>
          <Icon name="globe" /><span
            >Soporte en todo<br /><strong>el Ecuador</strong></span>
        </div>
        <div>
          <Icon name="cloud" /><span
            >Tu información disponible<br /><strong
              >desde cualquier lugar</strong
            ></span>
        </div>
        <div>
          <Icon name="refresh" /><span
            >Servicio anual con<br /><strong>actualizaciones incluidas</strong
            ></span>
        </div>
      </div>
    </div>
    <section
      class:list={[container, sectionSpace]}
      id="soluciones"
      aria-labelledby="solutions-title"
    >
      <div class="mb-11 flex items-end justify-between gap-[50px] max-[850px]:gap-[25px] max-sm:mb-[25px] max-sm:flex-col max-sm:items-start max-sm:gap-[17px]">
        <div>
          <p class={sectionLabel}>Nuestras soluciones</p><h2 class={heading2}
            id="solutions-title"
          >
            Cuatro soluciones.<br />Un negocio conectado.
          </h2>
        </div><p class="pb-[5px] text-[18px] text-muted max-[850px]:max-w-[260px] max-[850px]:text-[16px] max-sm:max-w-none max-sm:text-[17px]">
          Elige lo que tu empresa necesita hoy.<br />Nosotros te ayudamos a dar
          el siguiente paso.
        </p>
      </div>
      <div class="mb-[42px] grid grid-cols-4 gap-3 border-b border-line max-[850px]:grid-cols-2 max-[850px]:gap-x-5 max-[850px]:gap-y-0 max-sm:mb-[29px] max-sm:gap-x-3" aria-label="Elige una solución">
        {
          products.map((p, i) => (
            <a
              href={`#${p.id}`}
              class:list={["solution-choice group relative -mb-px flex min-w-0 items-center gap-4 border-b-[3px] border-transparent px-3 pb-[26px] pt-[22px] hover:bg-[#faf9fc] max-[1100px]:gap-2.5 max-[1100px]:px-1 max-[850px]:flex-row max-[850px]:items-center max-[850px]:px-1 max-[850px]:py-[18px] max-sm:gap-2", p.color, { active: i === 0 }]}
              data-solution={p.id}
              aria-current={i === 0 ? "true" : undefined}
            >
              <>
                <span class="grid size-12 shrink-0 place-items-center rounded-[11px] bg-[var(--product-soft)] text-[var(--product-color)] max-[1100px]:size-[38px] max-sm:size-8 max-sm:[&_svg]:size-[21px]">
                  <Icon name={p.icon} />
                </span>
                <span>
                  <>
                    <strong class="block font-heading text-[17px] font-semibold tracking-[-0.025em] max-[1100px]:text-[14px] max-[850px]:min-h-0 max-[850px]:text-[14px] max-sm:min-h-0 max-sm:text-[13px] max-sm:leading-[1.4]">{p.name}</strong>
                    <span class="mt-0.5 block text-[15px] text-muted max-[1100px]:text-[12px] max-sm:text-[11px]">{productDetails[p.id].subtitle}</span>
                  </>
                </span>
                <span class="hidden"><Icon name="diagonal" /></span>
              </>
            </a>
          ))
        }
      </div>
      <div class="product-panels">
        {
          products.map((p, i) => (
            <article
              id={p.id}
              class:list={["product-panel grid scroll-mt-[25px] grid-cols-2 items-center gap-[72px] pt-5 max-[1100px]:gap-10 max-[850px]:grid-cols-1 max-[850px]:gap-[35px] max-sm:gap-[27px] max-sm:pt-2", p.color]}
              data-panel={p.id}
            >
              <div class="product-copy max-[850px]:max-w-[600px]">
                <>
                  <p class="mb-4 text-[16px] font-semibold text-[var(--product-color)] max-sm:mb-[13px] max-sm:text-[14px]">{p.category}</p>
                  <h3 class="max-w-[480px] text-balance font-heading text-[clamp(27px,2.6vw,36px)] font-semibold leading-[1.25] tracking-[-0.045em] max-[850px]:max-w-[600px] max-sm:text-[29px]">{p.title}</h3>
                  <p class="mt-5 max-w-[480px] text-muted max-[850px]:max-w-[600px] max-sm:mt-[17px] max-sm:text-[17px]">{p.description}</p>
                  <ul class="my-[25px] grid list-none grid-cols-2 gap-x-[18px] gap-y-3.5 p-0 max-sm:gap-x-2.5 max-sm:gap-y-[13px]">
                    {p.features.map((f) => (
                      <li class="flex items-start gap-2 text-[16px] leading-[1.35] max-sm:text-[14px] [&_svg]:mt-0.5 [&_svg]:size-[17px] [&_svg]:text-[var(--product-color)]">
                        <Icon name="check" />
                        {f}
                      </li>
                    ))}
                  </ul>
                  <a
                    class:list={[button, "bg-[var(--product-color)] text-white hover:bg-ink max-sm:text-[16px]"]}
                    href={whatsapp + encodeURIComponent(p.message)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {p.cta}
                    <Icon name="chat" />
                  </a>
                </>
              </div>
              <div
                class="overflow-hidden rounded-2xl border border-line bg-[var(--product-soft)] max-[850px]:w-full max-[850px]:max-w-[600px]"
                aria-label={`Funciones de ${p.name}`}
              >
                <div class="flex items-center gap-3 border-b border-line bg-white px-[22px] py-4 max-sm:gap-[9px] max-sm:px-4 max-sm:py-3.5">
                  <>
                    <span class="grid size-[35px] shrink-0 place-items-center rounded-lg bg-[var(--product-soft)] text-[var(--product-color)] max-sm:size-[30px] [&_svg]:size-5">
                      <Icon name={p.icon} />
                    </span>
                    <strong class="font-heading text-[15px] font-semibold tracking-[-0.025em] max-sm:text-[13px]">{p.name}</strong>
                    <span class="ml-auto flex items-center gap-1.5 text-[12px] text-muted max-sm:text-[11px] [&_svg]:size-[15px]">
                      <Icon
                        name={
                          i === 2
                            ? "users"
                            : p.id === "guias-camaroneras"
                              ? "globe"
                              : "cloud"
                        }
                      />{" "}
                      {i === 2
                        ? "Multicontribuyente"
                        : p.id === "guias-camaroneras"
                          ? "100 % web"
                          : "En la nube"}
                    </span>
                  </>
                </div>
                <div class="px-[27px] pb-5 pt-[27px] text-center max-sm:px-[15px] max-sm:pb-[18px] max-sm:pt-[22px]">
                  <span class="text-[14px] text-muted max-sm:text-[12px]">
                    {productDetails[p.id].kicker}
                  </span>
                  <div class="illustration-hub relative flex flex-col items-center px-0 pb-[25px] pt-[22px]">
                    <>
                      <span class="mb-[9px] grid size-16 place-items-center rounded-2xl border border-white bg-white/70 text-[var(--product-color)] [&_svg]:size-[34px]">
                        <Icon name={p.icon} />
                      </span>
                      <strong class="font-heading text-[21px] tracking-[-0.04em]">{productDetails[p.id].hub}</strong>
                      <span class="text-[13px] text-muted">{productDetails[p.id].hubDescription}</span>
                    </>
                  </div>
                  <div class="connected-features relative grid grid-cols-2 gap-3 pt-[18px] max-sm:gap-[9px]">
                    {(p.visualFeatures ?? p.features).map((f, j) => (
                      <div class="flex items-center gap-2.5 rounded-[7px] border border-white bg-white/75 px-[13px] py-[15px] text-left text-[13px] leading-[1.3] max-sm:gap-2 max-sm:px-[9px] max-sm:py-3 max-sm:text-[12px] [&_svg]:size-5 [&_svg]:text-[var(--product-color)] max-sm:[&_svg]:size-[18px]">
                        <Icon
                          name={
                            (p.id === "guias-camaroneras"
                              ? ["waves", "truck", "globe", "document"]
                              : ["document", "box", "chart", "users"])[j]
