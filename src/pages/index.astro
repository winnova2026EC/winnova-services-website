---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Connection from "../components/Connection.astro";
import { Image } from "astro:assets";
import logo from "../assets/imagenes/logo.jpeg";

const whatsapp = "https://wa.me/593984206215?text=";
const contact =
  whatsapp +
  encodeURIComponent(
    "Hola, me gustaría conocer las soluciones de Winnova Solutions para mi negocio.",
  );
const edocsAccess = "https://facturacionlinkservices.com/acceso_seguro.php";
const guidesAccess = "https://guias.facturacionlinkservices.com/login";
const supremoDownload = "/downloads/Supremo_Winnova.exe";

const container =
  "mx-auto w-[min(1240px,calc(100%-112px))] max-desktop:w-[calc(100%-72px)] max-tablet:w-[calc(100%-48px)] max-sm:w-[calc(100%-40px)]";
const heading2 =
  "font-heading text-[clamp(30px,3.2vw,44px)] font-semibold leading-[1.2] tracking-[-0.055em] text-balance max-sm:text-[32px]";
const sectionLabel =
  "mb-3.75 text-[16px] font-semibold text-brand-blue max-sm:mb-3 max-sm:text-[14px]";
const button =
  "inline-flex min-h-13.5 items-center justify-center gap-4 rounded-lg border border-transparent px-5.75 py-4 text-[17px] font-semibold leading-tight [&_svg]:size-5";
const textLink =
  "inline-flex min-h-11 items-center gap-2.5 text-[17px] font-semibold hover:text-brand-blue [&_svg]:size-4.75";
const sectionSpace = "py-27 max-tablet:py-19 max-sm:py-14.5";

const products = [
  {
    id: "contable",
    name: "Cubo Contable",
    category: "Tu empresa, en un solo lugar",
    icon: "cube",
    color: "blue",
    title: "Menos tareas sueltas. Más control de tu negocio.",
    description:
      "Conecta tu contabilidad, facturación e inventarios en una plataforma web. Trabaja con tu equipo y tu contador, desde cualquier lugar y dispositivo.",
    features: [
      "Contabilidad y balances",
      "Inventarios y compras",
      "Facturación electrónica y ATS",
      "Cuentas por cobrar y pagar",
    ],
    cta: "Conocer Cubo Contable",
    message:
      "Hola, quiero conocer Cubo Contable y cómo se adapta a mi empresa.",
  },
  {
    id: "edocs",
    name: "Cubo e-Docs",
    category: "De la emisión a la entrega",
    icon: "document",
    color: "pink",
    title: "Tus documentos electrónicos, con el camino resuelto.",
    description:
      "Automatiza la firma, el envío al SRI y la entrega de comprobantes a tus clientes y proveedores. Consulta su autorización desde un portal en la nube.",
    features: [
      "Firma automática de XML",
      "Envío y consulta al SRI",
      "Correos automáticos",
      "Portal de comprobantes",
    ],
    cta: "Conocer Cubo e-Docs",
    message:
      "Hola, me gustaría conocer Cubo e-Docs para mis documentos electrónicos.",
  },
  {
    id: "descargas",
    name: "Descarga SRI",
    category: "Del comprobante a la información",
    icon: "download",
    color: "amber",
    title: "Más información a mano. Menos trabajo manual.",
    description:
      "Descarga de forma masiva tus comprobantes emitidos y recibidos del SRI. Obtén los XML, genera RIDE en PDF y organiza la información de varios contribuyentes.",
    features: [
      "Descarga masiva de XML",
      "Generación de RIDE en PDF",
      "Registros para ATS",
      "Reportes y exportación a Excel",
    ],
    cta: "Conocer Descarga SRI",
    message:
      "Hola, quiero información sobre la descarga masiva de comprobantes del SRI.",
  },
  {
    id: "guias-camaroneras",
    name: "Guías electrónicas",
    category: "Para el sector camaronero",
    icon: "truck",
    color: "cyan",
    title: "De la piscina al destino. Tus guías, en menos tiempo.",
    description:
      "Solución 100 % web para generar y gestionar Guías de Remisión Electrónicas del sector camaronero. Agiliza el registro de tu operación y accede desde cualquier navegador y diferentes ubicaciones.",
    features: [
      "Camaroneras y piscinas de origen",
      "Artículos y productos",
      "Transportistas y choferes",
      "Gestión de destinos",
      "Cantidades expresadas en libras",
      "Usuarios y contraseñas",
      "Roles y permisos por función",
      "Generación ágil de guías electrónicas",
    ],
    visualFeatures: [
      "Camaroneras y piscinas",
      "Transportistas y choferes",
      "Destinos y libras",
      "Guías electrónicas",
    ],
    cta: "Conocer Guías electrónicas",
    message:
      "Hola, quiero conocer la solución de Guías de Remisión Electrónicas para el sector camaronero.",
  },
];

const productDetails: Record<
  string,
  {
    subtitle: string;
    kicker: string;
    hub: string;
    hubDescription: string;
    note: string;
  }
> = {
  contable: {
    subtitle: "Contabilidad en la nube",
    kicker: "Todo empieza con una visión completa",
    hub: "Tu empresa",
    hubDescription: "Una sola plataforma",
    note: "Mac, Windows o Linux. Tú eliges.",
  },
  edocs: {
    subtitle: "Facturación electrónica",
    kicker: "Un proceso conectado de principio a fin",
    hub: "Tu comprobante",
    hubDescription: "Firma, envío y consulta",
    note: "Consulta tus documentos desde el portal web.",
  },
  descargas: {
    subtitle: "Comprobantes en orden",
    kicker: "Tu información, lista para trabajar",
    hub: "Tus documentos",
    hubDescription: "Emitidos y recibidos",
    note: "Varios contribuyentes. Un mismo sistema.",
  },
  "guias-camaroneras": {
    subtitle: "Sector camaronero",
    kicker: "Guías de Remisión Electrónicas para tu operación",
    hub: "Tu movilización",
    hubDescription: "Del origen al destino",
    note: "Acceso web con usuarios, roles y permisos.",
  },
};
const modules = [
  {
    icon: "document",
    title: "Ventas y facturación",
    text: "Facturación electrónica, generación de ATS y gestión de clientes. Conecta tu operación comercial con tu contabilidad.",
  },
  {
    icon: "box",
    title: "Inventarios y compras",
    text: "Administra inventarios o servicios, proveedores, importaciones y el ingreso de compras y retenciones mediante archivos TXT.",
  },
  {
    icon: "wallet",
    title: "Finanzas y tesorería",
    text: "Organiza cuentas por cobrar y pagar, bancos, cajas, cheques y tarjetas, junto con el control de activos fijos.",
  },
  {
    icon: "chart",
    title: "Contabilidad y reportes",
    text: "Consulta balances, mayores y libros diarios. Trabaja con información centralizada para entender el estado de tu empresa.",
  },
  {
    icon: "users",
    title: "Equipo y permisos",
    text: "Colabora con varios usuarios. Define roles y permisos para que cada persona acceda a la información que necesita.",
  },
  {
    icon: "connect",
    title: "Integraciones y flexibilidad",
    text: "Conecta aplicaciones externas mediante APIs y adapta las funcionalidades a las necesidades específicas de tu empresa.",
  },
];
---

<Layout>
  <a
    class="fixed left-3 top-3 z-100 translate-y-[-150%] bg-ink px-5 py-3 text-white focus:translate-y-0"
    href="#contenido">Ir al contenido</a
  >

  <header class="sticky top-0 z-30 border-b border-line bg-white">
    <div
      class:list={[
        container,
        "flex min-h-23.5 items-center justify-between gap-7.5 max-tablet:min-h-20 max-tablet:gap-5 max-sm:min-h-19 max-sm:gap-3",
      ]}
    >
      <a
        class="inline-block shrink-0 [&_img]:mix-blend-multiply [&_img]:brightness-[1.035] max-tablet:[&_img]:w-43.75 max-sm:[&_img]:w-40"
        href="/"
        aria-label="Winnova Solutions, inicio"
        ><Image
          src={logo}
          alt="Winnova Solutions"
          width={200}
          height={69}
          loading="eager"
        /></a
      >
      <nav
        class="ml-auto mr-8.5 flex gap-9.5 text-[17px] font-medium max-tablet:mr-0 max-tablet:gap-5.5 max-tablet:text-[15px] max-sm:hidden [&_a]:py-3 [&_a:hover]:text-brand-blue"
        aria-label="Navegación principal"
      >
        <a href="#soluciones">Soluciones</a><a href="#nosotros">Nosotros</a><a
          href="#soporte">Soporte</a
        >
      </nav>
      <a
        class:list={[
          button,
          "min-h-11.5 bg-[linear-gradient(115deg,#2454c6_0%,#7137c8_52%,#b42375_100%)] px-5 py-3 text-white shadow-[0_8px_20px_rgba(93,45,174,.22)] hover:brightness-110 max-tablet:px-3.5 max-tablet:text-[15px] max-sm:hidden",
        ]}
        href={contact}
        target="_blank"
        rel="noopener noreferrer">Hablemos <Icon name="chat" /></a
      >
      <button
        class="menu-toggle hidden size-11.5 items-center justify-center rounded-md border border-line bg-white text-ink max-sm:flex"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"><Icon name="menu" /></button
      >
    </div><nav
      id="mobile-nav"
      class="mobile-nav absolute inset-x-0 top-full border-t border-line bg-white px-6 pb-5 pt-2 shadow-[0_16px_24px_#21174712] [&_a]:block [&_a]:px-2 [&_a]:py-3"
      aria-label="Navegación móvil"
      hidden
    >
      <a href="#soluciones">Soluciones</a><a href="#nosotros">Nosotros</a><a
        href="#soporte">Soporte</a
      ><a href={contact} target="_blank" rel="noopener noreferrer"
        >Hablemos por WhatsApp</a
      >
    </nav>
    <div
      class="bg-[linear-gradient(90deg,#211747_0%,#45248d_48%,#8e236f_100%)] text-white"
    >
      <div
        class:list={[
          container,
          "flex min-h-10.5 items-center justify-end gap-5.5 text-[14px] max-sm:min-h-14 max-sm:justify-center max-sm:text-center max-sm:text-[12px] max-sm:leading-tight",
        ]}
      >
        <span class="text-[#cfc8e2] max-sm:hidden">Accesos para clientes</span>
        <nav
          class="flex items-center max-sm:grid max-sm:w-full max-sm:grid-cols-[1.35fr_.85fr] [&_a]:inline-flex [&_a]:min-h-10.5 [&_a]:items-center [&_a]:gap-2 [&_a]:font-semibold [&_a:hover]:text-brand-cyan [&_a_svg]:size-4.25 max-sm:[&_a]:min-h-14 max-sm:[&_a]:justify-center max-sm:[&_a]:gap-1.25 max-sm:[&_a]:px-2 max-sm:[&_a_svg]:size-3.75 [&_a+a]:ml-5.5 [&_a+a]:border-l [&_a+a]:border-white/20 [&_a+a]:pl-5.5 max-sm:[&_a+a]:ml-0 max-sm:[&_a+a]:pl-2"
          aria-label="Accesos a plataformas"
        >
          <a href={edocsAccess} target="_blank" rel="noopener noreferrer">
            Consultar comprobantes electrónicos <Icon name="diagonal" />
          </a>
          <a href={guidesAccess} target="_blank" rel="noopener noreferrer">
            Generación de guías <Icon name="diagonal" />
          </a>
        </nav>
      </div>
    </div>
  </header>

  <main id="contenido">
    <section
      class:list={[
        container,
        "flex items-start gap-13 pb-16 pt-17 wide:gap-20 max-desktop:gap-7 max-tablet:gap-5 max-tablet:py-13 max-sm:flex-col max-sm:gap-9 max-sm:pb-9 max-sm:pt-9.5",
      ]}
      id="inicio"
      aria-labelledby="hero-title"
    >
      <div class="min-w-0 flex-1 py-2.5 max-sm:w-full max-sm:p-0">
        <h1
          class="animate-fade-up font-heading text-[clamp(56px,5.5vw,78px)] font-semibold leading-[1.055] tracking-[-0.065em] max-desktop:text-[62px] max-tablet:text-[51px] max-sm:text-[clamp(47px,12.5vw,65px)] max-sm:leading-[1.06]"
          id="hero-title"
        >
          Tu negocio,<br />en buena<br />conexión.
        </h1>
        <p
          class="animate-fade-up mt-6.5 max-w-113.75 text-[19px] leading-[1.55] text-muted max-tablet:text-[17px] max-sm:mt-5.5 max-sm:max-w-112.5 max-sm:text-[18px]"
        >
          Contabilidad, facturación electrónica, comprobantes y guías de
          remisión. Soluciones para organizar tu empresa y seguir creciendo.
        </p>
        <div
          class="animate-fade-up mt-7.5 flex flex-wrap items-center gap-5.25 max-desktop:gap-3 max-tablet:flex-col max-tablet:items-start max-tablet:gap-2.5 max-sm:mt-6.25 max-sm:flex-row max-sm:gap-x-4.75 max-sm:gap-y-3.5"
        >
          <a
            class:list={[
              button,
              "bg-brand-blue text-white hover:bg-[#193c99] max-desktop:px-4 max-desktop:text-[15px] max-sm:px-4.75 max-sm:text-[16px]",
            ]}
            href={contact}
            target="_blank"
            rel="noopener noreferrer"
            >Hablemos de tu negocio <Icon name="chat" /></a
          ><a
            class:list={[textLink, "text-[16px] max-desktop:text-[15px]"]}
            href="#soluciones">Explorar soluciones <Icon name="down" /></a
          >
        </div>
      </div>
      <div
        class="min-w-0 flex-1 max-sm:mx-auto max-sm:w-full max-sm:max-w-117.5"
      >
        <Connection />
      </div>
    </section>
    <div class="border-y border-line bg-[#faf9fc]">
      <div
        class:list={[
          container,
          "grid grid-cols-[1.03fr_.94fr_1.05fr_1.15fr] py-7.25 max-tablet:grid-cols-2 max-tablet:gap-y-6.5 max-tablet:py-6.5 max-sm:[&_svg]:size-5.75 [&>div]:flex [&>div]:items-center [&>div]:gap-4.5 [&>div]:border-l [&>div]:border-[#ded9e9] [&>div]:pl-8.5 [&>div]:text-[15px] [&>div]:leading-[1.4] [&>div]:text-muted max-desktop:[&>div]:gap-3 max-desktop:[&>div]:pl-5.5 max-desktop:[&>div]:text-[14px] max-tablet:[&>div:nth-child(3)]:border-0 max-tablet:[&>div:nth-child(3)]:pl-0 max-sm:[&>div]:gap-2.5 max-sm:[&>div]:pl-4.5 max-sm:[&>div]:text-[12px] [&>div:first-child]:flex-col [&>div:first-child]:items-start [&>div:first-child]:gap-0.5 [&>div:first-child]:border-0 [&>div:first-child]:pl-0 [&_svg]:size-6.75 [&_svg]:text-[#776899] [&_strong]:font-semibold [&_strong]:text-ink",
        ]}
      >
        <div>
          <span
            class="font-heading text-[23px] font-semibold tracking-[-0.045em] text-ink max-desktop:text-[21px] max-sm:text-[20px]"
            >Desde 2014</span
          ><span>implementando software</span>
        </div>
        <div>
          <Icon name="globe" /><span
            >Soporte en todo<br /><strong>el Ecuador</strong></span
          >
        </div>
        <div>
          <Icon name="cloud" /><span
            >Tu información disponible<br /><strong
              >desde cualquier lugar</strong
            ></span
          >
        </div>
        <div>
          <Icon name="refresh" /><span
            >Servicio anual con<br /><strong>actualizaciones incluidas</strong
            ></span
          >
        </div>
      </div>
    </div>
    <section
      class:list={[container, sectionSpace]}
      id="soluciones"
      aria-labelledby="solutions-title"
    >
      <div
        class="mb-11 flex items-end justify-between gap-12.5 max-tablet:gap-6.25 max-sm:mb-6.25 max-sm:flex-col max-sm:items-start max-sm:gap-4.25"
      >
        <div>
          <p class={sectionLabel}>Nuestras soluciones</p><h2
            class={heading2}
            id="solutions-title"
          >
            Cuatro soluciones.<br />Un negocio conectado.
          </h2>
        </div><p
          class="pb-1.25 text-[18px] text-muted max-tablet:max-w-65 max-tablet:text-[16px] max-sm:max-w-none max-sm:text-[17px]"
        >
          Elige lo que tu empresa necesita hoy.<br />Nosotros te ayudamos a dar
          el siguiente paso.
        </p>
      </div>
      <div
        class="grid gap-30 pt-6 max-desktop:gap-24 max-tablet:gap-20 max-sm:gap-16 max-sm:pt-3"
      >
        {
          products.map((p, i) => (
            <article
              id={p.id}
              class:list={[
                "grid scroll-mt-42.5 grid-cols-2 items-center gap-18 max-desktop:gap-10 max-tablet:scroll-mt-38.75 max-tablet:grid-cols-1 max-tablet:gap-8.75 max-sm:gap-6.75",
                p.color,
              ]}
            >
              <div
                class:list={[
                  "product-copy max-tablet:order-1 max-tablet:max-w-150",
                  { "order-2": i % 2 === 1 },
                ]}
              >
                <>
                  <p class="mb-4 text-[16px] font-semibold text-(--product-color) max-sm:mb-3.25 max-sm:text-[14px]">
                    {p.category}
                  </p>
                  <h3 class="max-w-120 text-balance font-heading text-[clamp(27px,2.6vw,36px)] font-semibold leading-tight tracking-[-0.045em] max-tablet:max-w-150 max-sm:text-[29px]">
                    {p.title}
                  </h3>
                  <p class="mt-5 max-w-120 text-muted max-tablet:max-w-150 max-sm:mt-4.25 max-sm:text-[17px]">
                    {p.description}
                  </p>
                  <ul class="my-6.25 grid list-none grid-cols-2 gap-x-4.5 gap-y-3.5 p-0 max-sm:gap-x-2.5 max-sm:gap-y-3.25">
                    {p.features.map((f) => (
                      <li class="flex items-start gap-2 text-[16px] leading-[1.35] max-sm:text-[14px] [&_svg]:mt-0.5 [&_svg]:size-4.25 [&_svg]:text-(--product-color)">
                        <Icon name="check" />
                        {f}
                      </li>
                    ))}
                  </ul>
                  <a
                    class:list={[
                      button,
                      "bg-(--product-color) text-white hover:bg-ink max-sm:text-[16px]",
                    ]}
                    href={whatsapp + encodeURIComponent(p.message)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {p.cta}
                    <Icon name="chat" />
                  </a>
                </>
              </div>
              <div
                class:list={[
                  "product-illustration overflow-hidden rounded-2xl border border-line bg-(--product-soft) max-tablet:order-2 max-tablet:w-full max-tablet:max-w-150",
                  { "order-1": i % 2 === 1 },
                ]}
                aria-label={`Funciones de ${p.name}`}
              >
                <div class="flex items-center gap-3 border-b border-line bg-white px-5.5 py-4 max-sm:gap-2.25 max-sm:px-4 max-sm:py-3.5">
                  <>
                    <span class="grid size-8.75 shrink-0 place-items-center rounded-lg bg-(--product-soft) text-(--product-color) max-sm:size-7.5 [&_svg]:size-5">
                      <Icon name={p.icon} />
                    </span>
                    <strong class="font-heading text-[15px] font-semibold tracking-tight max-sm:text-[13px]">
                      {p.name}
                    </strong>
                    <span class="ml-auto flex items-center gap-1.5 text-[12px] text-muted max-sm:text-[11px] [&_svg]:size-3.75">
                      <Icon
                        name={
                          i === 2
                            ? "users"
                            : p.id === "guias-camaroneras"
                              ? "globe"
                              : "cloud"
                        }
                      />{" "}
                      {i === 2
                        ? "Multicontribuyente"
                        : p.id === "guias-camaroneras"
                          ? "100 % web"
                          : "En la nube"}
                    </span>
                  </>
                </div>
                <div class="px-6.75 pb-5 pt-6.75 text-center max-sm:px-3.75 max-sm:pb-4.5 max-sm:pt-5.5">
                  <span class="text-[14px] text-muted max-sm:text-[12px]">
                    {productDetails[p.id].kicker}
                  </span>
                  <div class="illustration-hub relative flex flex-col items-center px-0 pb-6.25 pt-5.5">
                    <>
                      <span class="mb-2.25 grid size-16 place-items-center rounded-2xl border border-white bg-white/70 text-(--product-color) [&_svg]:size-8.5">
                        <Icon name={p.icon} />
                      </span>
                      <strong class="font-heading text-[21px] tracking-[-0.04em]">
                        {productDetails[p.id].hub}
                      </strong>
                      <span class="text-[13px] text-muted">
                        {productDetails[p.id].hubDescription}
                      </span>
                    </>
                  </div>
                  <div class="connected-features relative grid grid-cols-2 gap-3 pt-4.5 max-sm:gap-2.25">
                    {(p.visualFeatures ?? p.features).map((f, j) => (
                      <div class="flex items-center gap-2.5 rounded-[7px] border border-white bg-white/75 px-3.25 py-3.75 text-left text-[13px] leading-[1.3] max-sm:gap-2 max-sm:px-2.25 max-sm:py-3 max-sm:text-[12px] [&_svg]:size-5 [&_svg]:text-(--product-color) max-sm:[&_svg]:size-4.5">
                        <Icon
                          name={
                            (p.id === "guias-camaroneras"
                              ? ["waves", "truck", "globe", "document"]
                              : ["document", "box", "chart", "users"])[j]
                          }
                        />
                        <span>{f}</span>
                      </div>
                    ))}
                  </div>
                  <div class="mt-5.5 flex items-center justify-center gap-2 text-[13px] text-muted max-sm:gap-1.5 max-sm:text-[11px] [&_svg]:size-4 [&_svg]:text-(--product-color)">
                    <Icon name="check-circle" />
                    {productDetails[p.id].note}
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>
    <section
      class="bg-lavender py-22.5 max-tablet:py-14.5"
      aria-labelledby="modules-title"
    >
      <div
        class:list={[
          container,
          "grid grid-cols-[.85fr_1.15fr] gap-25 max-desktop:gap-13.75 max-tablet:grid-cols-[1fr_1.3fr] max-tablet:gap-8.75 max-sm:grid-cols-1 max-sm:gap-7",
        ]}
      >
        <div class="modules-intro">
          <p class={sectionLabel}>Dentro de Cubo Contable</p><h2
            class={heading2}
            id="modules-title"
          >
            Cada área.<br />El mismo equipo.
          </h2><p
            class="mt-6 max-w-91.25 text-muted max-sm:mt-4.75 max-sm:max-w-none max-sm:text-[17px]"
          >
            De la primera factura al balance final: administra las áreas de tu
            empresa con información centralizada y en tiempo real.
          </p><div
            class="relative mt-8.75 grid size-32.5 place-items-center rounded-full border border-[#dcd5f0] max-tablet:hidden [&>svg]:size-14.5 [&>svg]:stroke-1 [&>svg]:text-[#8574b4]"
            aria-hidden="true"
          >
